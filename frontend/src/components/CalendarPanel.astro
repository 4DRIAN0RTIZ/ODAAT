---
const navButtonClass =
	'inline-flex h-9 w-9 items-center justify-center rounded-full border border-stone-200/80 bg-white/70 font-serif text-stone-600 transition-colors hover:border-emerald-200 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300';
---

<div
	id="calendar-backdrop"
	class="fixed inset-0 flex items-center justify-center bg-stone-900/30 px-4 backdrop-blur-sm"
	style="z-index: 10000;"
	hidden
>
	<div
		id="calendar-panel"
		role="dialog"
		aria-modal="true"
		aria-label="Calendario de reflexiones"
		class="w-full max-w-sm rounded-[2rem] border border-white/80 bg-[#f7f6f1] p-5 font-serif text-stone-700 shadow-[0_20px_60px_-20px_rgba(68,64,60,0.35)] sm:p-6"
	>
		<div class="mb-4 flex items-center justify-between gap-2">
			<button id="calendar-prev" type="button" class={navButtonClass} aria-label="Mes anterior">
				<span aria-hidden="true">‹</span>
			</button>
			<h2 id="calendar-title" class="text-lg font-medium capitalize text-stone-800" aria-live="polite"></h2>
			<button id="calendar-next" type="button" class={navButtonClass} aria-label="Mes siguiente">
				<span aria-hidden="true">›</span>
			</button>
		</div>
		<div class="grid grid-cols-7 gap-1 text-center text-xs text-stone-500" aria-hidden="true">
			<span>Lu</span><span>Ma</span><span>Mi</span><span>Ju</span><span>Vi</span><span>Sá</span><span>Do</span>
		</div>
		<div id="calendar-grid" class="mt-1 grid grid-cols-7 gap-1"></div>
		<div class="mt-4 flex justify-end">
			<button
				id="calendar-close"
				type="button"
				class="rounded-full border border-stone-200/80 bg-white/70 px-4 py-1.5 text-sm text-stone-600 transition-colors hover:border-emerald-200 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"
			>
				Cerrar
			</button>
		</div>
	</div>
</div>
