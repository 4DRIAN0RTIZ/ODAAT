---
import { Reflection } from '../lib/api'
import favicon from '../assets/favicon.webp'

interface Props {
	reflection: Reflection;
}

---

<button
	id="random-reflection-button"
	class="group fixed top-4 right-4 inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 font-serif text-sm tracking-wide text-stone-600 shadow-sm backdrop-blur transition-all duration-300 hover:border-emerald-200 hover:bg-white/80 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50"
	disabled
	aria-busy="true"
	style="z-index: 9999;"
>
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-60 transition-all duration-500 group-hover:rotate-180 group-hover:opacity-100">
	<path d="M21 12a9 9 0 0 0-15-6.7L3 8" />
	<path d="M3 3v5h5" />
	<path d="M3 12a9 9 0 0 0 15 6.7l3-2.7" />
	<path d="M16 16h5v5" />
	</svg>
<span>Otra reflexión</span>
	</button>

<div
	id="container"
	class="min-h-screen bg-[#f7f6f1] text-stone-700 selection:bg-emerald-100 selection:text-emerald-950"
>
	<main class="relative overflow-hidden">
		<!-- Ambient background -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0"
		>
			<div
				class="absolute -left-32 -top-40 h-[30rem] w-[30rem] rounded-full bg-emerald-100/40 blur-3xl"
			></div>

			<div
				class="absolute -right-40 top-1/3 h-[28rem] w-[28rem] rounded-full bg-sky-100/40 blur-3xl"
			></div>
		</div>

		<article
			class="relative mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center px-6 py-20 sm:px-10 lg:py-28"
		>
			<!-- Header -->
			<header class="mb-12 text-center sm:mb-16">
				<div
					class="mb-7 inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 text-stone-500 shadow-sm backdrop-blur"
				>
					<img
						src={favicon.src}
						alt="ODAAT"
						class="rounded-full h-12 w-12">
				</div>

				<h1
					class="text-balance font-serif text-4xl leading-tight font-medium tracking-tight text-stone-800 sm:text-5xl lg:text-6xl"
					id="reflection-title"
				>
					{Astro.props.reflection.title}
				</h1>

				<div class="mx-auto mt-8 flex items-center justify-center gap-4">
					<span class="h-px w-10 bg-stone-300"></span>

					<time
						class="text-sm tracking-wide text-stone-500"
						id="reflection-date"
					>
						{Astro.props.reflection.date_label}
					</time>

					<span class="h-px w-10 bg-stone-300"></span>
				</div>
			</header>

			<!-- Reflection -->
			<section
				class="rounded-[2rem] border border-white/80 bg-white/55 px-7 py-9 shadow-[0_20px_60px_-30px_rgba(68,64,60,0.18)] backdrop-blur-sm sm:px-10 sm:py-12"
			>
				<div
					class="space-y-7 font-serif text-[1.15rem] leading-[1.95] text-stone-600 sm:text-xl"
					id="reflection-paragraphs"
				>
					{
						Astro.props.reflection.paragraphs.map(
							(paragraph) => (
								<p>
									{paragraph}
								</p>
							)
						)
					}
				</div>
			</section>

			<!-- Image actions -->
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<button
					id="download-reflection-button"
					type="button"
					class="inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 font-serif text-sm tracking-wide text-stone-600 shadow-sm backdrop-blur transition-all duration-300 hover:border-emerald-200 hover:bg-white/80 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50"
					disabled
					aria-busy="true"
				>
					<span>Descargar imagen</span>
				</button>
				<button
					id="share-reflection-button"
					type="button"
					class="inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 font-serif text-sm tracking-wide text-stone-600 shadow-sm backdrop-blur transition-all duration-300 hover:border-emerald-200 hover:bg-white/80 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50"
					disabled
					aria-busy="true"
				>
					<span>Copiar imagen</span>
				</button>
			</div>

			<!-- Source -->
			<footer class="mt-10 flex justify-center">
				<a
					href="https://odaat.cuevaneander.tech"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex max-w-full items-center gap-3 rounded-full px-4 py-2 text-sm text-stone-500 transition-all duration-300 hover:bg-white/70 hover:text-emerald-800"
					id="reflection-source"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="shrink-0 opacity-60 transition-opacity group-hover:opacity-100"
					>
						<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
						<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
					</svg>

					<span class="truncate"
						id="reflection-source-text">
						https://odaat.cuevaneander.tech
					</span>
				</a>
			</footer>
		</article>
	</main>
</div>

<script>
	import { getRandomReflection } from '../lib/api'
	import { applyReflectionToDom } from '../lib/dom'
	import { notifications } from '../lib/notifications';
	import { canShareFiles, renderReflectionPng, slugify } from '../lib/share-image';

	const downloadButton = document.getElementById('download-reflection-button');
	const shareButton = document.getElementById('share-reflection-button');

	function readCurrentReflection() {
		const title = document.getElementById('reflection-title')?.textContent?.trim() ?? '';
		const date_label = document.getElementById('reflection-date')?.textContent?.trim() ?? '';
		const paragraphs = Array.from(
			document.querySelectorAll('#reflection-paragraphs p'),
			(p) => p.textContent?.trim() ?? '',
		).filter(Boolean);
		return { title, date_label, paragraphs };
	}

	async function buildImageFile(): Promise<File> {
		const reflection = readCurrentReflection();
		const blob = await renderReflectionPng(reflection);
		return new File([blob], `odaat-${slugify(reflection.title)}.png`, { type: 'image/png' });
	}

	function downloadFile(file: File) {
		const url = URL.createObjectURL(file);
		const a = document.createElement('a');
		a.href = url;
		a.download = file.name;
		document.body.appendChild(a);
		a.click();
		a.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	async function copyImageToClipboard(file: File): Promise<boolean> {
		if (typeof ClipboardItem === 'undefined' || !navigator.clipboard?.write) return false;
		try {
			await navigator.clipboard.write([new ClipboardItem({ [file.type]: file })]);
			return true;
		} catch {
			return false;
		}
	}

	function toastImageError() {
		notifications.toast({
			title: 'No se pudo crear la imagen',
			text: 'No pudimos generar la imagen. Intenta nuevamente.',
			icon: 'error',
			duration: 5000,
		});
	}

	if (downloadButton instanceof HTMLButtonElement) {
		downloadButton.addEventListener('click', async () => {
			downloadButton.disabled = true;
			try {
				downloadFile(await buildImageFile());
			} catch {
				toastImageError();
			} finally {
				downloadButton.disabled = false;
			}
		});
	}

	if (shareButton instanceof HTMLButtonElement) {
		const probe = new File([], 'probe.png', { type: 'image/png' });
		if (canShareFiles(navigator, probe)) {
			const label = shareButton.querySelector('span');
			if (label) label.textContent = 'Compartir imagen';
		}
		shareButton.addEventListener('click', async () => {
			shareButton.disabled = true;
			try {
				const file = await buildImageFile();
				if (canShareFiles(navigator, file)) {
					try {
						await navigator.share({ files: [file], title: file.name });
					} catch (error) {
						// Closing the share sheet is not an error.
						if (!(error instanceof DOMException && error.name === 'AbortError')) throw error;
					}
				} else if (await copyImageToClipboard(file)) {
					notifications.toast({
						title: 'Imagen copiada',
						text: 'Pégala donde quieras compartirla.',
						icon: 'success',
						duration: 4000,
					});
				} else {
					downloadFile(file);
					notifications.toast({
						title: 'Compartir no disponible',
						text: 'Tu navegador no puede compartir ni copiar imágenes. Descargamos el PNG para que lo compartas manualmente.',
						icon: 'info',
						duration: 6000,
					});
				}
			} catch {
				toastImageError();
			} finally {
				shareButton.disabled = false;
			}
		});
	}

	const boton = document.getElementById('random-reflection-button');
	if (!(boton instanceof HTMLButtonElement)) {
		// Shell not present
	} else {
		boton.addEventListener('click', async () => {
			boton.disabled = true;
			try {
				const reflection = await getRandomReflection();
				applyReflectionToDom(reflection);
			} catch {
				notifications.toast({
					title: 'No se pudo cargar',
					text: 'No pudimos obtener otra reflexión. Intenta nuevamente.',
					icon: 'error',
					duration: 5000,
				});
			} finally {
				boton.disabled = false;
			}
		});
	}
</script>
