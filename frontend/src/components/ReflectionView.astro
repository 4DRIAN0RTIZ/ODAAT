---
import { Reflection } from '../lib/api'
import favicon from '../assets/favicon.webp'

interface Props {
	reflection: Reflection;
}

---

<button
	id="random-reflection-button"
	class="group fixed top-4 right-4 inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 font-serif text-sm tracking-wide text-stone-600 shadow-sm backdrop-blur transition-all duration-300 hover:border-emerald-200 hover:bg-white/80 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"
	style="z-index: 9999;"
>
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-60 transition-all duration-500 group-hover:rotate-180 group-hover:opacity-100">
	<path d="M21 12a9 9 0 0 0-15-6.7L3 8" />
	<path d="M3 3v5h5" />
	<path d="M3 12a9 9 0 0 0 15 6.7l3-2.7" />
	<path d="M16 16h5v5" />
	</svg>
<span>Otra reflexión</span>
	</button>




<div
	id="container"
	class="min-h-screen bg-[#f7f6f1] text-stone-700 selection:bg-emerald-100 selection:text-emerald-950"
>
	<main class="relative overflow-hidden">
		<!-- Ambient background -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0"
		>
			<div
				class="absolute -left-32 -top-40 h-[30rem] w-[30rem] rounded-full bg-emerald-100/40 blur-3xl"
			></div>

			<div
				class="absolute -right-40 top-1/3 h-[28rem] w-[28rem] rounded-full bg-sky-100/40 blur-3xl"
			></div>
		</div>

		<article
			class="relative mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center px-6 py-20 sm:px-10 lg:py-28"
		>
			<!-- Header -->
			<header class="mb-12 text-center sm:mb-16">
				<div
					class="mb-7 inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 text-stone-500 shadow-sm backdrop-blur"
				>
					<img
						src={favicon.src}
						alt="ODAAT"
						class="rounded-full h-12 w-12">
				</div>

				<h1
					class="text-balance font-serif text-4xl leading-tight font-medium tracking-tight text-stone-800 sm:text-5xl lg:text-6xl"
					id="reflection-title"
				>
					{Astro.props.reflection.title}
				</h1>

				<div class="mx-auto mt-8 flex items-center justify-center gap-4">
					<span class="h-px w-10 bg-stone-300"></span>

					<time
						class="text-sm tracking-wide text-stone-500"
						id="reflection-date"
					>
						{Astro.props.reflection.date_label}
					</time>

					<span class="h-px w-10 bg-stone-300"></span>
				</div>
			</header>

			<!-- Reflection -->
			<section
				class="rounded-[2rem] border border-white/80 bg-white/55 px-7 py-9 shadow-[0_20px_60px_-30px_rgba(68,64,60,0.18)] backdrop-blur-sm sm:px-10 sm:py-12"
			>
				<div
					class="space-y-7 font-serif text-[1.15rem] leading-[1.95] text-stone-600 sm:text-xl"
					id="reflection-paragraphs"
				>
					{
						Astro.props.reflection.paragraphs.map(
							(paragraph, index) => (
								<p>
									{paragraph}
								</p>
							)
						)
					}
				</div>
			</section>

			<!-- Source -->
			<footer class="mt-10 flex justify-center">
				<a
					href="https://odaat.cuevaneander.tech"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex max-w-full items-center gap-3 rounded-full px-4 py-2 text-sm text-stone-500 transition-all duration-300 hover:bg-white/70 hover:text-emerald-800"
					id="reflection-source"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="shrink-0 opacity-60 transition-opacity group-hover:opacity-100"
					>
						<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
						<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
					</svg>

					<span class="truncate"
						id="reflection-source-text">
						https://odaat.cuevaneander.tech
					</span>
				</a>
			</footer>
		</article>
	</main>
</div>

<script>
	import { getRandomReflection } from '../lib/api'

	const boton = document.getElementById('random-reflection-button');
	if (boton) {
	boton.addEventListener('click', async () => {
		boton.disabled = true; // Disable the button to prevent multiple clicks
		try {
			const reflection = await getRandomReflection();
			if (reflection) {
				// Update the page with the new reflection
				const reflectionTitle = document.getElementById('reflection-title');
				const reflectionDate = document.getElementById('reflection-date');
				const reflectionParagraphs = document.getElementById('reflection-paragraphs');
				const reflectionSource = document.getElementById('reflection-source');
				const reflectionSourceText = document.getElementById('reflection-source-text');

				if (!reflectionTitle || !reflectionDate || !reflectionParagraphs || !reflectionSource || !reflectionSourceText || !(reflectionSource instanceof HTMLAnchorElement)) {
					console.error('One or more elements not found');
					return;
				}

				reflectionTitle.textContent = reflection.title;
				reflectionDate.textContent = reflection.date_label;
				reflectionParagraphs.replaceChildren();
				reflection.paragraphs.forEach(paragraph => {
					const p = document.createElement('p');
					p.textContent = paragraph;
					reflectionParagraphs.appendChild(p);
				});
				reflectionSource.href = reflection.source_url;
				reflectionSourceText.textContent = reflection.source_url;
			}
		}
		catch (error) {
			console.error('Error updating reflection:', error);
		} finally {
			boton.disabled = false; // Re-enable the button after the operation
		}
	});
	}
</script>
