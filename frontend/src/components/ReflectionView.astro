---
import { Reflection } from '../lib/api'
import favicon from '../assets/favicon.webp'

interface Props {
	reflection: Reflection;
}

---

<div
	id="container"
	class="min-h-screen bg-[#f7f6f1] text-stone-700 selection:bg-emerald-100 selection:text-emerald-950"
>
	<main class="relative overflow-hidden">
		<!-- Ambient background -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0"
		>
			<div
				class="absolute -left-32 -top-40 h-[30rem] w-[30rem] rounded-full bg-emerald-100/40 blur-3xl"
			></div>

			<div
				class="absolute -right-40 top-1/3 h-[28rem] w-[28rem] rounded-full bg-sky-100/40 blur-3xl"
			></div>
		</div>

		<article
			class="relative mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center px-6 py-20 sm:px-10 lg:py-28"
		>
			<!-- Header -->
			<header class="mb-12 text-center sm:mb-16">
				<div
					class="mb-7 inline-flex items-center gap-2 rounded-full border border-stone-200/80 bg-white/60 px-4 py-2 text-stone-500 shadow-sm backdrop-blur"
				>
					<img
						src={favicon.src}
						alt="ODAAT"
						class="rounded-full h-12 w-12">
				</div>

				<h1
					class="text-balance font-serif text-4xl leading-tight font-medium tracking-tight text-stone-800 sm:text-5xl lg:text-6xl"
				>
					{Astro.props.reflection.title}
				</h1>

				<div class="mx-auto mt-8 flex items-center justify-center gap-4">
					<span class="h-px w-10 bg-stone-300"></span>

					<time
						class="text-sm tracking-wide text-stone-500"
					>
						{Astro.props.reflection.date_label}
					</time>

					<span class="h-px w-10 bg-stone-300"></span>
				</div>
			</header>

			<!-- Reflection -->
			<section
				class="rounded-[2rem] border border-white/80 bg-white/55 px-7 py-9 shadow-[0_20px_60px_-30px_rgba(68,64,60,0.18)] backdrop-blur-sm sm:px-10 sm:py-12"
			>
				<div
					class="space-y-7 font-serif text-[1.15rem] leading-[1.95] text-stone-600 sm:text-xl"
				>
					{
						Astro.props.reflection.paragraphs.map(
							(paragraph, index) => (
								<p>
									{paragraph}
								</p>
							)
						)
					}
				</div>
			</section>

			<!-- Source -->
			<footer class="mt-10 flex justify-center">
				<a
					href="https://odaat.cuevaneander.tech"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex max-w-full items-center gap-3 rounded-full px-4 py-2 text-sm text-stone-500 transition-all duration-300 hover:bg-white/70 hover:text-emerald-800"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="shrink-0 opacity-60 transition-opacity group-hover:opacity-100"
					>
						<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
						<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
					</svg>

					<span class="truncate">
						https://odaat.cuevaneander.tech
					</span>
				</a>
			</footer>
		</article>
	</main>
</div>
