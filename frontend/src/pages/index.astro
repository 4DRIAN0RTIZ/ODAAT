---
import ReflectionView from '../components/ReflectionView.astro';
import Layout from '../layouts/Layout.astro';

import { getTodaysReflection } from '../lib/api';

let reflection: Awaited<ReturnType<typeof getTodaysReflection>> | undefined;
let initialLoadFailed = false;

try {
	reflection = await getTodaysReflection();
} catch {
	initialLoadFailed = true;
}
---

<Layout>
	{initialLoadFailed ? (
		<main class="flex min-h-screen items-center justify-center bg-[#f7f6f1] px-6 text-center text-stone-600">
			<section aria-labelledby="server-status-title">
				<h1 id="server-status-title" class="font-serif text-3xl text-stone-800">Conectando con el servidor…</h1>
				<p id="server-status" class="mt-4" role="status" aria-live="polite">
					Comprobando la conexión.
				</p>
			</section>
		</main>

		<script>
			import { serverReady } from '../lib/api';
			import { notifications } from '../lib/notifications';

			const MESSAGES_IDLE = [
				'Comprobando la conexión…',
				'Preparando la reflexión de hoy…',
				'Consultando el servidor…',
				'Buscando la reflexión de hoy…',
				'Veamos qué nos trae el día…',
				'Casi listo…',
			];
			const MESSAGES_WAKEUP = [
				'El servidor está despertando…',
				'Esto puede tardar unos segundos…',
				'Aún estamos esperando al servidor…',
				'El servicio está volviendo a la vida…',
				'Estamos preparando la conexión…',
				'La primera respuesta puede tardar un poco…',
				'El servidor sigue trabajando…',
				'No te preocupes, seguimos intentando…',
				'La conexión está casi lista…',
				'Estamos recuperando el servicio…',
				'Gracias por tu paciencia…',
				'La reflexión estará disponible en breve…',
				'El servidor está tomando impulso…',
				'Continuamos esperando una respuesta…',
				'La conexión sigue en marcha…',
				'Estamos a punto de terminar…',
				'El servicio necesita unos instantes más…',
				'La reflexión está casi preparada…',
				'Seguimos conectando con el servidor…',
				'El servidor está finalizando su arranque…',
				'Un momento más y estaremos listos…',
				'La respuesta debería llegar pronto…',
				'Estamos manteniendo la conexión activa…',
				'Últimos segundos de espera…',
				'¡Gracias por esperar con nosotros!',
			];
			const WAKEUP_AFTER_MS = 15000;
			const waitStartedAt = Date.now();
			const status = document.getElementById('server-status');
			let messageIndex = 0;
			let messageTimer: ReturnType<typeof setInterval> | undefined;

			function showNextMessage() {
				if (!status) return;
				const messages = Date.now() - waitStartedAt >= WAKEUP_AFTER_MS
					? MESSAGES_WAKEUP
					: MESSAGES_IDLE;
				status.textContent = messages[messageIndex % messages.length];
				messageIndex += 1;
			}

			notifications.toast({
				title: 'Conectando',
				text: 'El servidor está despertando…',
				icon: 'warning',
				duration: 5000,
			});
			showNextMessage();
			messageTimer = setInterval(showNextMessage, 3000);

			serverReady().then(() => {
				if (messageTimer) clearInterval(messageTimer);
				notifications.toast({
					title: 'Servidor listo',
					text: 'Cargando la reflexión de hoy…',
					icon: 'success',
					duration: 3000,
				});
				window.location.reload();
			}).catch(() => {
				if (messageTimer) clearInterval(messageTimer);
				if (status) status.textContent = 'El servidor no respondió. Reintenta más tarde.';
				notifications.toast({
					title: 'Sin conexión',
					text: 'El servidor no respondió. Reintenta más tarde.',
					icon: 'error',
					duration: 5000,
				});
			});
		</script>
	) : (
		<ReflectionView reflection={reflection} />
	)}
</Layout>
